# ─────────────────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in the values.
# `.env*` is gitignored — never commit real credentials.
# ─────────────────────────────────────────────────────────────

# Neon Postgres — pooled connection string from the Neon dashboard.
# Must include `?sslmode=require`.
DATABASE_URL="postgresql://user:password@ep-xxx.region.aws.neon.tech/portfolio?sslmode=require"

# Secret used to sign admin session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating this value invalidates every existing session.
AUTH_SECRET=""

# Credentials for the initial admin user, read only by `pnpm db:seed`.
# Remove them from the environment once the account exists.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Rajan Shrestha"

# Cloudinary — Dashboard → Product Environment Credentials.
# The cloud name is public (it appears in delivery URLs); the secret is not.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Canonical origin, used for SEO metadata and Open Graph URLs.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# AI assistant — the "Ask about me" chat. Optional: with no key the
# chat simply doesn't render, even if it's switched on in the CMS.
# ─────────────────────────────────────────────────────────────


AI_PROVIDER=""
AI_API_KEY=""

AI_MODEL=""


